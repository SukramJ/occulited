{
  "name": "occulited-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The web UI of occulited: the shell of an openccu-lite box",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf ../internal/ui/dist/assets && vite build && node scripts/starting-page.mjs",
